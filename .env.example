# Verified public site origin (absolute HTTPS URL) for server-rendered canonicals/social URLs; leave blank until confirmed.
PUBLIC_SITE_URL=
# The same verified HTTPS origin is used by client-side metadata.
VITE_PUBLIC_SITE_URL=
# The verified WhatsApp number is single-sourced in client/src/data/businessConfig.ts.
# Optional analytics IDs; leave blank until consent and vendor configuration are in place.
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
# Email-provider credentials belong in server-side protected environment configuration, never here.
